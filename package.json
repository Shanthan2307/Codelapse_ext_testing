{
  "name": "codelapse",
  "displayName": "CodeLapse",
  "description": "Passive background recorder, analytics, and timelapse replays for VS Code",
  "version": "0.0.1",
  "publisher": "shanthan2307",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shanthan2307/Codelapse_ext.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codelapse.startSession",
        "title": "CodeLapse: Start Recording Session"
      },
      {
        "command": "codelapse.selectFolder",
        "title": "CodeLapse: Choose Folder to Record"
      },
      {
        "command": "codelapse.stopSession",
        "title": "CodeLapse: Stop Recording Session"
      },
      {
        "command": "codelapse.showReport",
        "title": "CodeLapse: Show Session Report & Analytics"
      },
      {
        "command": "codelapse.exportHtmlReport",
        "title": "CodeLapse: Export Standalone HTML Report"
      },
      {
        "command": "codelapse.openReplay",
        "title": "CodeLapse: Open Session Replay & Analytics"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codelapse.selectFolder",
          "when": "explorerResourceIsFolder",
          "group": "z_codelapse"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "mocha -r ts-node/register 'src/test/suite/**/*.test.ts'",
    "test:integration": "npm run compile && tsc -p tsconfig.integration.json && node out/test/runIntegration.js"
  },
  "dependencies": {
    "@types/prismjs": "^1.26.6",
    "lucide-react": "^1.16.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "css-loader": "^7.1.2",
    "glob": "^13.0.6",
    "mocha": "^11.3.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
